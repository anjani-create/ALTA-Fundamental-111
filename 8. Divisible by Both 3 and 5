// Write a program to check whether a given number is divisible by both 3 and 5. Input: 45  Output: Yes
#include <iostream>
using namespace std;
int main() {
    int num;
    cout << "Enter a number:";
    cin >> num;

    if (num % 3 == 0 && num % 5 == 0) {
        cout << "Yes"<<endl;
    }
    else {
        cout << "No"<<endl;
    }
    return 0;
}
