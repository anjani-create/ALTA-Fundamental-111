// Write a program that prints numbers from 1 to N, but for multiples of 3 print "Fizz" instead of the number, for multiples of 5 print "Buzz", and for multiples of both print "FizzBuzz". Input: N = 15
#include <iostream>
using namespace std;
int main() {
    int N;
    cout << "Enter a number:";
    cin >> N;
    
    for (int i = 1; i <= N; ++i) {
        
        if (i % 3 == 0 && i % 5 == 0) {
           cout << "FizzBuzz" << endl;
        } 
        
        else if (i % 3 == 0) {
           cout << "Fizz" << endl;
        } 
        
        else if (i % 5 == 0) {
            cout << "Buzz" << endl;
        } 
        
        else {
            cout << i << endl;
        }
    }
    
    return 0;
}
