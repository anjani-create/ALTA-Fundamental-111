// Write a program that prints numbers from 1 to N but uses continue to skip printing any multiple of 3. Input: N = 10  Output: 1 2 4 5 7 8 10
#include <iostream>
using namespace std;

int main() {
    int N;
    
    cout << "Enter the number N: ";
    cin >> N;
    
    cout << "Numbers from 1 to " << N << " (excluding multiples of 3):" << endl;
    
    for (int i = 1; i <= N; i++) {
        if (i % 3 == 0) {
            continue;
        }
        
        cout << i << " ";
    }
    
    cout << endl;
    return 0;
}
